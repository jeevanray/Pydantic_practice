CREATE TABLE hive.default.segmentationmetadata03 (
   advid varchar,
   datasourcename varchar,
   dimension varchar,
   datatype varchar,
   dbtype varchar,
   dbname varchar,
   tablecollectionname varchar,
   isenumerable varchar,
   primaryidentifier varchar,
   display_dimensions varchar,
   display_datasourcename varchar,
   cteventidentifier varchar,
   propertiesidentifier varchar,
   isrts varchar,
   cteventdateidentifier varchar
)
WITH (
   external_location = 's3a://bgs-out-athena/segmentationmetadata_latest',
   format = 'CSV',
   skip_header_line_count = 1
)



CREATE VIEW minio.segmentdb_6550.segmentationmetadata SECURITY DEFINER AS
SELECT
  advid
, datasourcename
, dimension
, datatype
, dbtype
, dbname
, tablecollectionname
, (CASE WHEN (LOWER(trim(BOTH FROM isenumerable)) IN ('true', '1', 'yes')) THEN true ELSE false END) isenumerable
, (CASE WHEN (LOWER(trim(BOTH FROM primaryidentifier)) IN ('true', '1', 'yes')) THEN true ELSE false END) primaryidentifier
, display_dimensions
, display_datasourcename
, (CASE WHEN (LOWER(trim(BOTH FROM cteventidentifier)) IN ('true', '1', 'yes')) THEN true ELSE false END) cteventidentifier
, (CASE WHEN (LOWER(trim(BOTH FROM propertiesidentifier)) IN ('true', '1', 'yes')) THEN true ELSE false END) propertiesidentifier
, isrts
, (CASE WHEN (LOWER(trim(BOTH FROM cteventdateidentifier)) IN ('true', '1', 'yes')) THEN true ELSE false END) cteventdateidentifier
FROM
  hive.default.segmentationmetadata03








